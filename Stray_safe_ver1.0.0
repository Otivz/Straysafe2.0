DROP TABLE IF EXISTS `pet_claims`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `pet_claims` (
  `claim_id` int NOT NULL AUTO_INCREMENT,
  `report_id` int NOT NULL,
  `pet_id` int NOT NULL,
  `status` enum('Potential Owner Match','Possible Match Found','Pending Review','Approved','Rejected','Evidence Requested') NOT NULL DEFAULT 'Potential Owner Match',
  `evidence_url` varchar(255) DEFAULT NULL,
  `remarks` text,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `vaccine_card_url` varchar(255) DEFAULT NULL,
  `vet_record_url` varchar(255) DEFAULT NULL,
  `registration_record_url` varchar(255) DEFAULT NULL,
  `additional_photos_url` varchar(255) DEFAULT NULL,
  `distinctive_markings` text,
  PRIMARY KEY (`claim_id`),
  KEY `report_id` (`report_id`),
  KEY `pet_id` (`pet_id`),
  CONSTRAINT `pet_claims_ibfk_1` FOREIGN KEY (`report_id`) REFERENCES `reports` (`report_id`) ON DELETE CASCADE,
  CONSTRAINT `pet_claims_ibfk_2` FOREIGN KEY (`pet_id`) REFERENCES `pets` (`pet_id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=50 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

