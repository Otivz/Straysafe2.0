INSERT INTO `announcements` VALUES (1,NULL,1,2,5,'Community Rabies Vaccination Drive','ATTENTION RESIDENTS:\n\nThe Homeowners Association, in coordination with the Municipal Veterinary Office, will conduct a free Rabies Vaccination Drive for all registered dogs and cats within the subdivision.\n\nDate: June 15, 2026\nTime: 8:00 AM – 12:00 PM\nLocation: Community Covered Court\n\nPet owners are encouraged to bring their pets on a leash, carrier, or with proper restraints to ensure everyone\'s safety. Vaccination records will be provided after the event.\n\nRabies is a serious public health concern, and regular vaccination helps protect both pets and residents. Please participate and help keep our community safe.\n\nFor inquiries, contact the Subdivision Management Office.',NULL,'Public','Emergency','Published',1,'2026-06-09 15:29:32','2026-07-14 16:00:00','2026-06-09 15:29:32','2026-06-09 15:29:32');
/*!40000 ALTER TABLE `announcements` ENABLE KEYS */;
UNLOCK TABLES;

