# Database Configuration
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost/straysafe_db
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=straysafe_db

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Frontend Vite Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Security / JWT Secret Key (Generate a random 64-character secret key)
JWT_SECRET_KEY=generate_a_random_64_character_secret_key_here
SECRET_KEY=generate_a_random_64_character_secret_key_here

# Initial Admin & Seed Account Credentials
ADMIN_EMAIL=admin@straysafe.com
ADMIN_PASSWORD=change_this_admin_password

CITIZEN_EMAIL=citizen@straysafe.com
SUBD_LEADER_EMAIL=leader@straysafe.com
BRGY_STAFF_EMAIL=staff@straysafe.com
SEED_PASSWORD=change_this_seed_password

# External Breed & AI APIs
VITE_DOG_API_KEY=your_thedogapi_key
VITE_CAT_API_KEY=your_thecatapi_key
GEMINI_API_KEY=your_google_gemini_api_key

# Google Sign-In (OAuth Web client ID from Google Cloud Console; the same value in both)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Email (Gmail SMTP). SMTP_PASSWORD is a 16-character Google App Password, not the Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=StraySafe
# true = also return the OTP in the API response (local testing only, never on a real server)
OTP_DEBUG=false

# Set to true on any deployment served over HTTPS so the login cookie never travels over plain HTTP
COOKIE_SECURE=false

# true = administrators must also enter a code emailed to them after their password.
# Turn this on only after the admin account's email is a real inbox you can open (and SMTP works).
# If you ever get locked out, set it back to false and restart the backend.
ADMIN_LOGIN_2FA=false
