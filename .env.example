# Database Configuration
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost/straysafe_db
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=straysafe_db

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Frontend Vite Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Security / JWT Secret Key (Generate a random 64-character secret key)
JWT_SECRET_KEY=generate_a_random_64_character_secret_key_here
SECRET_KEY=generate_a_random_64_character_secret_key_here

# Initial Admin & Seed Account Credentials
ADMIN_EMAIL=admin@straysafe.com
ADMIN_PASSWORD=change_this_admin_password

CITIZEN_EMAIL=citizen@straysafe.com
SUBD_LEADER_EMAIL=leader@straysafe.com
BRGY_STAFF_EMAIL=staff@straysafe.com
SEED_PASSWORD=change_this_seed_password

# External Breed & AI APIs
VITE_DOG_API_KEY=your_thedogapi_key
VITE_CAT_API_KEY=your_thecatapi_key
GEMINI_API_KEY=your_google_gemini_api_key
