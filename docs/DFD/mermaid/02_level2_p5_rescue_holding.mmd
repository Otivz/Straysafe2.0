    D1["D1 | Users"]:::store
    D2["D2 | Locations"]:::store
    D4["D4 | Reports"]:::store
    D7["D7 | Rescues and Holding"]:::store
    O3(["3.0 Process<br/>Reports"]):::off
    O7(["7.0 Manage<br/>Adoptions"]):::off
    LDR["Subdivision Leader"]:::ent
    O8(["8.0 Handle Communication<br/>and Notifications"]):::off

