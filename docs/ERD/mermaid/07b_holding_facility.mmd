---
config:
  theme: base
  themeVariables:
    background: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#000000"
    primaryBorderColor: "#000000"
    lineColor: "#000000"
    textColor: "#000000"
    secondaryColor: "#ffffff"
    tertiaryColor: "#ffffff"
    attributeBackgroundColorOdd: "#ffffff"
    attributeBackgroundColorEven: "#f2f2f2"
    fontFamily: "Arial, Helvetica, sans-serif"
    fontSize: "16px"
  er:
    layoutDirection: LR
    entityPadding: 12
    minEntityWidth: 120
    fontSize: 16
    useMaxWidth: false
---
erDiagram
    reports {
        int report_id PK
    }

    rescues {
        int rescue_id PK
    }

    holding_animals {
        int holding_id PK
        int report_id FK
        int rescue_id FK
        enum animal_type
        varchar animal_name
        varchar breed
        varchar color
        varchar estimated_size
        int facility_status FK
        varchar kennel_slot
        text medical_notes
        text adoption_catalog_notes
        datetime promoted_at
        int promoted_by FK
        datetime intake_date
        datetime discharge_date
        int intake_staff_id FK
        boolean overdue_notified
        enum sex
        varchar estimated_age
        datetime created_at
    }

    facility_status {
        int status_id PK
        varchar status_name UK
    }

    holding_timeline {
        int log_id PK
        int holding_id FK
        varchar event_type
        varchar title
        text notes
        int logged_by FK
        datetime logged_at
    }

    users {
        int user_id PK
    }

    reports ||--o{ holding_animals : "report_id"
    rescues |o--o{ holding_animals : "rescue_id"
    facility_status ||--o{ holding_animals : "facility_status"
    users |o--o{ holding_animals : "intake_staff_id"
    users |o--o{ holding_animals : "promoted_by"
    holding_animals ||--o{ holding_timeline : "holding_id"
    users |o--o{ holding_timeline : "logged_by"
